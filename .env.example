# Khidmati DZ — environment variables (placeholders only; never commit real values)

# --- Required ---------------------------------------------------------------
# PostgreSQL 16+ connection string. On Vercel + Neon this is the *pooled* URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Direct (non-pooled) URL used by migrations, seeding and admin provisioning.
# Optional: falls back to DATABASE_URL. Neon's Vercel integration sets it automatically.
DATABASE_URL_UNPOOLED=
# Public base URL of the site (used in e-mails, links, metadata).
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional ---------------------------------------------------------------
# Max connections per server instance (default 5).
DATABASE_POOL_MAX=5

# E-mail via Resend (https://resend.com). Both must be set or e-mail stays "not configured".
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=Khidmati <no-reply@your-domain.example>

# SMS via Twilio. All four must be set or SMS stays "not configured".
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# E-mail via SMTP, e.g. Gmail with an App password (used when Resend is not configured).
# With any e-mail sender configured, sign-up and sign-in on a new device require a 6-digit code.
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to Gmail (smtp.gmail.com, port 465) and "Khidmati <SMTP_USER>".
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# Development only: print e-mails to the server console (ignored in production).
DEV_EMAIL_CONSOLE=0

# Android app (App Links verification served at /.well-known/assetlinks.json).
# SHA-256 fingerprint(s) of the app signing certificate, comma-separated (AA:BB:…:FF).
ANDROID_APP_PACKAGE=dz.khidmati.app
ANDROID_CERT_SHA256=

# One-time web setup of the first super administrator (/installation). At least 32 random
# characters. The page closes itself for good once an admin exists; you can then delete this.
SETUP_TOKEN=

# --- One-off scripts (not needed at runtime) --------------------------------
# npm run admin:create
ADMIN_EMAIL=
ADMIN_NAME=
